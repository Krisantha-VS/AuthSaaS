DATABASE_URL="postgresql://user:password@host/auth-saas?sslmode=require"
JWT_ACCESS_SECRET="replace-with-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""

# Upstash Redis — required for distributed rate limiting and brute-force lockout.
# Get a free instance at https://upstash.com (Redis → REST API keys)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cookie domain — set to ".yourdomain.com" (with leading dot) to share the
# refresh-token cookie across subdomains (e.g. auth.royalda.com + royalda.com).
# Leave empty for single-host deployments.
COOKIE_DOMAIN=""
